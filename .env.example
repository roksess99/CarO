# Kopieer naar .env en vul in. .env wordt nooit gecommit.

# --- Tyre24 / ALZURA (docs/api/TYRE24.md) ---
# Token Management op tyre24.alzura.com — dit is een server-secret
TYRE24_API_TOKEN=
# NL base path verifiëren zodra het token er is (docs tonen /de/de/)
TYRE24_BASE_URL=https://tyre24.alzura.com/nl/nl/rest/v13/products
# Bepalen via GET /areas
TYRE24_PRODUCT_AREA_ID=

# --- Prijzen (docs/DECISIONS.md #5 — alleen voor ontwikkeling) ---
# Marge in procenten bovenop de B2B-inkoopprijs, bv. 35
CARO_MARGIN_PERCENT=35

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
