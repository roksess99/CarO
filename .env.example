# Kopieer naar .env en vul in. .env wordt nooit gecommit.

# --- Tyre24 / ALZURA (docs/api/TYRE24.md) ---
# Token Management op tyre24.alzura.com — dit is een server-secret
TYRE24_API_TOKEN=
# NL base path verifiëren zodra het token er is (docs tonen /de/de/)
TYRE24_BASE_URL=https://tyre24.alzura.com/nl/nl/rest/v13/products
# productArea voor de familie "banden" (6 = Banden op het NL-platform)
TYRE24_PRODUCT_AREA_ID=

# productArea voor de familie "onderdelen". Leeg = die familie toont een
# lege staat. Dit account heeft geen area met nieuwe onderdelen; area 10
# (gebruikte onderdelen) bestaat alleen op het DE-platform, dus dan ook
# TYRE24_PARTS_BASE_URL zetten. Zie docs/DECISIONS.md #7.
TYRE24_PARTS_AREA_ID=
# TYRE24_PARTS_BASE_URL=https://tyre24.alzura.com/de/de/rest/v13/products

# --- overheid.io / RDW kentekenzoeker (docs/api/OVERHEID-IO.md) ---
# overheid.io account → API-sleutel. Server-secret, nooit in de browser
OVERHEID_IO_API_KEY=

# --- Prijzen (docs/DECISIONS.md #5) ---
# We volgen de adviesverkoopprijs van de leverancier. Deze ondergrens is een
# vangnet: nooit minder marge dan dit percentage op de inkoopprijs.
CARO_MIN_MARGIN_PERCENT=25

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Volg de adviesverkoopprijs (evp) van de leverancier. "false" = eigen marge op inkoop
CARO_USE_RECOMMENDED_PRICE=true
