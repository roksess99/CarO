# Kopieer naar .env en vul in. .env staat in .gitignore — nooit committen.
#
# ==========================================================================
# DEPLOY-CHECKLIST (Hostinger)
# ==========================================================================
# Zet deze variabelen in elke omgeving die je draait. Een env-wijziging werkt
# niet door in een bestaande build: na het toevoegen opnieuw bouwen en
# herstarten, anders draait de site op mockdata.
#
#   [ ] TYRE24_API_TOKEN
#   [ ] TYRE24_WEARPARTS_TOKEN
#   [ ] OVERHEID_IO_API_KEY
#   [ ] NEXT_PUBLIC_SITE_URL   (het echte domein, niet localhost)
#   [ ] SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASSWORD
#       (zonder deze vier komt het contactformulier niet aan, en kan er
#        geen orderbevestiging verstuurd worden)
#   [ ] MOLLIE_API_KEY        (live_… zodra de winkel open gaat)
#   [ ] ORDER_ADMIN_EMAIL     (waar de inkoopmail heen moet)
#
# LET OP: dit bestand staat WEL in Git. Zet hier nooit een echte sleutel of
# een wachtwoord in — alleen de naam van de variabele. Een geheim dat hier
# ooit in heeft gestaan is via de geschiedenis terug te lezen en moet
# vervangen worden, niet alleen weggehaald.
#
# De rest is optioneel; laat leeg tenzij je bewust afwijkt.
# ==========================================================================

# --- VERPLICHT ---

# Tyre24 / ALZURA Products v1.3 — banden, velgen, toebehoren.
# docs/api/TYRE24.md. Zonder dit token valt de hele catalogus terug op de mock.
TYRE24_API_TOKEN=

# Tyre24 / ALZURA Wearparts v1.6 — onderdelen, kenteken -> TecDoc-voertuig,
# categorieboom. EIGEN token, werkt niet op de Products-API en andersom.
# docs/api/WEARPARTS.md.
TYRE24_WEARPARTS_TOKEN=

# overheid.io — RDW-voertuiggegevens bij een kenteken (docs/api/OVERHEID-IO.md).
# Zonder dit toont de kentekenzoeker "tijdelijk niet beschikbaar".
OVERHEID_IO_API_KEY=

# Basis-URL van de site, gebruikt voor canonical- en hreflang-tags
# (src/lib/site.ts). Publiek — vandaar de NEXT_PUBLIC-prefix.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Uitgaande mail: het contactformulier stuurt naar info@caroparts.nl
# (src/lib/mail.ts). Dit is de mailbox bij de hostingpartij, niet een
# verstuurdienst — gebruik dus de gegevens van díe mailbox.
# Poort 465 = SSL, 587 = STARTTLS; de code kiest daarop.
# Het wachtwoord is een geheim: alleen in .env en in het wachtwoordbeheer.
# Controleren of het klopt: `pnpm mail:check` (verbindt en meldt zich aan),
# of `pnpm mail:check --send` om jezelf een testbericht te sturen.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@caroparts.nl
SMTP_PASSWORD=

# Mollie — betalingen (docs/DECISIONS.md #10). De sleutel staat in het Mollie
# dashboard onder Ontwikkelaars > API-sleutels en begint met `test_` of
# `live_`. Test- en live-sleutel horen bij gescheiden werelden: met een
# testsleutel wordt er nooit echt geld overgemaakt.
# Zonder deze sleutel meldt de checkout eerlijk dat betalen niet kan.
MOLLIE_API_KEY=

# --- OPTIONEEL ---

# Waar de inkoopmail met de PDF naartoe gaat. Leeg = hetzelfde adres als in
# src/lib/company.ts (info@caroparts.nl).
ORDER_ADMIN_EMAIL=

# Map waarin bestellingen als JSON bewaard worden. Leeg = <project>/.data/orders.
# Op de server: zet hier een pad BUITEN de projectmap, bijvoorbeeld
# /home/<gebruiker>/caro-orders. Een nieuwe deploy vervangt de projectmap en
# neemt anders de bestellingen mee. Zie src/lib/orders/store.ts.
ORDER_DATA_DIR=


# Prijsstrategie, zie docs/DECISIONS.md #5. Standaard: adviesprijs volgen met
# een ondergrens van 25% op de inkoopprijs.
CARO_MIN_MARGIN_PERCENT=25
CARO_USE_RECOMMENDED_PRICE=true

# Noodknoppen voor als de leverancier zijn paden wijzigt. Leeg laten.
# TYRE24_BASE_URL_NL=https://tyre24.alzura.com/nl/nl/rest/v13/products
# TYRE24_BASE_URL_DE=https://tyre24.alzura.com/de/de/rest/v13/products

# Alloys v1.3 — lichtmetalen velgen. Wordt nog nergens gelezen; fase 6.
TYRE24_ALLOYS_TOKEN=
